{
  "name": "keeper",
  "private": true,
  "version": "0.1.0",
  "description": "Keeper — AI-assisted culling for photos and videos.",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:schema": "npm run build --workspace @keeper/schema",
    "predev": "npm run build:schema",
    "dev": "npm --workspace app run dev",
    "prebuild": "npm run build:schema",
    "build": "npm --workspace app run build",
    "pretypecheck": "npm run build:schema",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:schema",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true,
    "electron@34.5.8": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.3": true
  }
}
