# User data (the media library) lives in ~/Pictures/Keeper (configurable),
# never in the repo. A local library/ from a dev KEEPER_LIBRARY_DIR override
# pointed at the repo is ignored too.
# NOTE: root-anchored — an unanchored pattern would also match
# app/src/renderer/src/styles/ and silently untrack the design system.
/library/
/.keeper/
/taste.json

.env
.env.local
